# .python-version

# pipenv
#   According to pypa/pipenv#1188, it is a recommended practice to PC commit the Lockfile.
#   However, in some cases, it may not be appropriate to commit it, for example, if the
#   package is meant to be installed via pip.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
# poetry.lock

# pdm
